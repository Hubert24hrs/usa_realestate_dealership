# ─────────────────────────────────────────────────────────────
# CITI VIEW REAL ESTATE — environment template
# Copy to .env.local and fill in what you have. Everything except
# DATABASE_URL / DIRECT_URL / AUTH_SECRET is optional: each service
# falls back to a safe local/dev behaviour when its key is empty.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Core ──
# Local default = the embedded Postgres started by `npm run db:start`.
# For Neon/Supabase (PostGIS), use the pooled URL here and the direct URL below.
DATABASE_URL="postgresql://citiview:citiview@localhost:54329/citiview"
DIRECT_URL="postgresql://citiview:citiview@localhost:54329/citiview"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Shows demo-data banners and one-click demo accounts.
NEXT_PUBLIC_DEMO_MODE="true"

# ── Auth.js ──
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Google sign-in appears only when both are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (Resend) ── empty key => emails go to the dev outbox (/dev/outbox)
RESEND_API_KEY=""
EMAIL_FROM="CITI VIEW <no-reply@example.com>"

# ── Maps ── empty token => MapLibre GL + free OpenFreeMap tiles
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ── Seed imagery (official APIs only) ──
PEXELS_API_KEY=""
UNSPLASH_ACCESS_KEY=""
UNSPLASH_APP_NAME="citi_view_real_estate"
# Optional image CDN for uploads/feed photos: "cloudinary:<cloud_name>" or an imgix base URL
NEXT_PUBLIC_IMAGE_CDN=""

# ── Search ── postgres (default, no extra service) | typesense
SEARCH_PROVIDER="postgres"
TYPESENSE_HOST=""
TYPESENSE_PORT="443"
TYPESENSE_PROTOCOL="https"
TYPESENSE_API_KEY=""
TYPESENSE_SEARCH_ONLY_KEY=""

# ── AI natural-language search (optional) ── empty => rule-based parser only
ANTHROPIC_API_KEY=""

# ── Payments (Stripe TEST mode keys only in development) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_AGENT_PRO=""
STRIPE_PRICE_AGENT_PREMIER=""

# ── Licensed MLS / IDX feed (RESO Web API, OAuth2 client credentials) ──
RESO_API_BASE_URL=""
RESO_TOKEN_URL=""
RESO_CLIENT_ID=""
RESO_CLIENT_SECRET=""
RESO_ORIGINATING_SYSTEM=""

# ── Web push (optional) ── generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ── Uploads ── local (stored in .data/uploads, served at /media/uploads — dev/self-host only)
#              | vercel-blob (requires BLOB_READ_WRITE_TOKEN; use this on Vercel)
UPLOAD_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# ── Rate limiting across instances (optional) ── empty => in-memory limiter
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Scheduled jobs (saved-search alerts) ──
CRON_SECRET=""
