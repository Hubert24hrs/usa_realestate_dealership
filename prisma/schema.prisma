// CITI VIEW REAL ESTATE — data model
// PostGIS is optional: lat/lng live on Listing; when the database has PostGIS,
// prisma/sql/postgis.sql maintains geo.listing_location (outside Prisma's schema)
// for polygon / radius queries. See src/lib/geo/spatial.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  USER
  AGENT
  BROKER
  PROPERTY_MANAGER
  ADMIN
}

enum ListingCategory {
  RESIDENTIAL
  RENTAL
  COMMERCIAL
  LAND
}

enum TransactionType {
  SALE
  RENT
  LEASE
}

enum ListingStatus {
  ACTIVE
  COMING_SOON
  PENDING
  SOLD
  RENTED
  OFF_MARKET
  DRAFT
}

enum PropertyType {
  SINGLE_FAMILY
  CONDO
  TOWNHOUSE
  MULTI_FAMILY
  MANUFACTURED
  APARTMENT
  LAND
  FARM_RANCH
  OFFICE
  RETAIL
  INDUSTRIAL
  MIXED_USE
  HOSPITALITY
}

enum ListingSource {
  SEED
  FEED
  FSBO
  AGENT
  ADMIN
}

enum MediaType {
  PHOTO
  VIDEO
  TOUR_3D
  FLOOR_PLAN
  DOCUMENT
}

enum MediaCategory {
  EXTERIOR
  LIVING_ROOM
  KITCHEN
  DINING_ROOM
  PRIMARY_BEDROOM
  BEDROOM
  BATHROOM
  BACKYARD
  AERIAL
  FLOOR_PLAN
  AMENITY
  VIEW
  OFFICE
  LOBBY
  WAREHOUSE
  RETAIL_SPACE
  LAND
  WATER
  FOREST
  PASTURE
  STRUCTURE
  TOPOGRAPHY
  OTHER
}

enum MediaProvider {
  PEXELS
  UNSPLASH
  GENERATED
  FEED
  UPLOAD
}

enum PriceEvent {
  LISTED
  PRICE_CHANGE
  PENDING
  SOLD
  DELISTED
  RELISTED
  RENTED
}

enum OpenHouseType {
  IN_PERSON
  VIRTUAL
}

enum TourType {
  IN_PERSON
  VIDEO
}

enum TourStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum LeadType {
  TOUR
  REQUEST_INFO
  ASK_AGENT
  OFFER_INTEREST
  CONTACT_AGENT
  PREAPPROVAL
  SELLER_CONSULT
  HOME_VALUE
  OM_REQUEST
  RENTAL_INQUIRY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NURTURE
  CLOSED
  LOST
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
  NONE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  WITHDRAWN
}

enum LeaseStatus {
  PENDING_SIGNATURE
  ACTIVE
  ENDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReportReason {
  INACCURATE_INFO
  SCAM_OR_FRAUD
  DISCRIMINATORY_LANGUAGE
  DUPLICATE
  NO_LONGER_AVAILABLE
  INAPPROPRIATE_MEDIA
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum PostType {
  NEWS
  GUIDE
  LEARN
  BLOG
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum OrgType {
  BROKERAGE
  PROPERTY_MANAGEMENT
}

enum PlanTier {
  FREE
  PRO
  PREMIER
}

enum SchoolLevel {
  ELEMENTARY
  MIDDLE
  HIGH
}

enum SchoolType {
  PUBLIC
  CHARTER
  PRIVATE
}

enum AmenityType {
  GROCERY
  PARK
  RESTAURANT
  COFFEE
  GYM
  TRANSIT
  HOSPITAL
  SHOPPING
  LIBRARY
}

enum NotificationType {
  ALERT_MATCH
  PRICE_DROP
  TOUR_UPDATE
  MESSAGE
  APPLICATION_UPDATE
  LEAD
  COLLECTION
  SYSTEM
}

enum CollectionRole {
  OWNER
  EDITOR
  VIEWER
}

// ───────────────────────────── Auth.js ─────────────────────────────

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String?       @unique
  emailVerified  DateTime?
  image          String?
  role           Role          @default(USER)
  phone          String?
  organizationId String?
  organization   Organization? @relation("OrgMembers", fields: [organizationId], references: [id], onDelete: SetNull)
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  accounts              Account[]
  sessions              Session[]
  agent                 Agent?
  ownedListings         Listing[]                @relation("ListingOwner")
  favorites             Favorite[]
  collections           Collection[]             @relation("CollectionOwner")
  collectionMemberships CollectionMember[]
  savedSearches         SavedSearch[]
  notes                 Note[]
  views                 ListingView[]
  tours                 TourRequest[]
  leads                 Lead[]
  applications          RentalApplication[]
  leases                Lease[]
  payments              RentPayment[]
  purchases             Purchase[]
  participants          ConversationParticipant[]
  messages              Message[]                @relation("MessageSender")
  notifications         Notification[]
  notificationPrefs     NotificationPreference?
  pushSubscriptions     PushSubscription[]
  reports               Report[]                 @relation("ReportAuthor")
  ndaAgreements         NdaAgreement[]
  uploads               Upload[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ───────────────────────────── Organizations & agents ─────────────────────────────

model Organization {
  id            String   @id @default(cuid())
  type          OrgType
  name          String
  slug          String   @unique
  tagline       String?
  description   String?  @db.Text
  licenseNumber String?
  licenseState  String?
  phone         String?
  email         String?
  website       String?
  address       String?
  city          String?
  state         String?
  zip           String?
  brandColor    String?
  foundedYear   Int?
  officeCount   Int?
  unitsManaged  Int?
  serviceAreas  String[]
  services      String[]
  isDemo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agents   Agent[]
  members  User[]    @relation("OrgMembers")
  listings Listing[]
}

model Agent {
  id                  String        @id @default(cuid())
  userId              String?       @unique
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name                String
  slug                String        @unique
  title               String?
  email               String
  phone               String?
  bio                 String?       @db.Text
  brandColor          String?
  photoUrl            String?
  licenseNumber       String?
  licenseState        String?
  yearsExperience     Int           @default(0)
  specialties         String[]
  languages           String[]
  areasServed         String[]
  designations        String[]
  rating              Float         @default(0)
  reviewCount         Int           @default(0)
  salesLast12Months   Int           @default(0)
  salesVolume12Mo     Float         @default(0)
  priceRangeLow       Int?
  priceRangeHigh      Int?
  responseTimeMinutes Int?
  plan                PlanTier      @default(FREE)
  stripeCustomerId    String?
  stripeSubscriptionId String?
  planRenewsAt        DateTime?
  acceptingLeads      Boolean       @default(true)
  leadWeight          Int           @default(1)
  lastLeadAt          DateTime?
  isDemo              Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  listings Listing[]
  reviews  AgentReview[]
  leads    Lead[]
  tours    TourRequest[]

  @@index([organizationId])
}

model AgentReview {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  authorName  String
  rating      Int
  title       String?
  body        String   @db.Text
  transaction String?
  location    String?
  isVerified  Boolean  @default(false)
  isDemo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([agentId])
}

// ───────────────────────────── Geography ─────────────────────────────

model State {
  code   String  @id
  name   String
  slug   String  @unique
  notice String? @db.Text
  cities City[]
}

model City {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  stateCode         String
  state             State    @relation(fields: [stateCode], references: [code])
  county            String?
  lat               Float
  lng               Float
  population        Int?
  description       String?  @db.Text
  heroColor         String?
  medianHomeValue   Int?
  medianRent        Int?
  costOfLivingIndex Float?
  costOfLiving      Json?
  isRural           Boolean  @default(false)
  seoTitle          String?
  seoDescription    String?
  updatedAt         DateTime @updatedAt

  neighborhoods Neighborhood[]
  schools       School[]
  districts     SchoolDistrict[]
  amenities     Amenity[]
  listings      Listing[]
  marketStats   MarketStat[]

  @@unique([name, stateCode])
}

model Neighborhood {
  id             String   @id @default(cuid())
  cityId         String
  city           City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?  @db.Text
  boundary       Json
  centerLat      Float
  centerLng      Float
  radiusDeg      Float    @default(0.008)
  walkScore      Int?
  transitScore   Int?
  bikeScore      Int?
  crimeIndex     Int?
  noiseLevel     Int?
  floodRisk      Int?
  medianPrice    Int?
  highlights     String[]
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt

  listings Listing[]

  @@unique([cityId, slug])
}

model SchoolDistrict {
  id       String   @id @default(cuid())
  cityId   String
  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name     String
  slug     String   @unique
  boundary Json
  rating   Int?
  schools  School[]
}

model School {
  id                  String          @id @default(cuid())
  cityId              String
  city                City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  districtId          String?
  district            SchoolDistrict? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  name                String
  slug                String          @unique
  level               SchoolLevel
  type                SchoolType
  grades              String
  rating              Int
  enrollment          Int?
  studentTeacherRatio Float?
  lat                 Float
  lng                 Float
  address             String?
  isDemo              Boolean         @default(true)

  listings ListingSchool[]

  @@index([cityId])
}

model Amenity {
  id     String      @id @default(cuid())
  cityId String
  city   City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name   String
  type   AmenityType
  lat    Float
  lng    Float

  @@index([cityId, type])
}

// ───────────────────────────── Listings ─────────────────────────────

model Listing {
  id              String          @id @default(cuid())
  slug            String          @unique
  mlsNumber       String?         @unique
  feedKey         String?         @unique
  category        ListingCategory
  transactionType TransactionType
  status          ListingStatus   @default(ACTIVE)
  propertyType    PropertyType
  source          ListingSource   @default(SEED)
  isDemo          Boolean         @default(true)
  headline        String?
  description     String          @db.Text

  // Price
  price          Int
  priceMax       Int?
  originalPrice  Int?
  priceReducedAt DateTime?
  priceReduction Int?
  pricePerSqft   Int?
  soldPrice      Int?
  soldDate       DateTime?
  listDate       DateTime        @default(now())

  // Address & location
  streetAddress  String
  unit           String?
  city           String
  state          String
  zip            String
  county         String?
  lat            Float
  lng            Float
  hideAddress    Boolean       @default(false)
  cityId         String?
  cityRef        City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  neighborhoodId String?
  neighborhood   Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)

  // Facts & features
  beds              Int?
  baths             Float?
  fullBaths         Int?
  halfBaths         Int?
  sqft              Int?
  lotSqft           Int?
  lotAcres          Float?
  yearBuilt         Int?
  stories           Int?
  garageSpaces      Int?
  parkingSpaces     Int?
  parkingType       String?
  hoaFee            Int?
  propertyTaxAnnual Int?
  taxAssessedValue  Int?
  hasPool           Boolean  @default(false)
  isWaterfront      Boolean  @default(false)
  hasView           Boolean  @default(false)
  hasBasement       Boolean  @default(false)
  hasYard           Boolean  @default(false)
  hasFireplace      Boolean  @default(false)
  hasAC             Boolean  @default(true)
  petsAllowed       Boolean  @default(false)
  catsAllowed       Boolean  @default(false)
  dogsAllowed       Boolean  @default(false)
  heating           String?
  cooling           String?
  flooring          String[]
  appliances        String[]
  interiorFeatures  String[]
  exteriorFeatures  String[]
  communityFeatures String[]
  utilities         String[]

  // Flags
  isNewConstruction Boolean @default(false)
  isForeclosure     Boolean @default(false)
  isFsbo            Boolean @default(false)
  isFeatured        Boolean @default(false)
  isLuxury          Boolean @default(false)
  has3dTour         Boolean @default(false)
  hasVideo          Boolean @default(false)
  virtualTourUrl    String?
  videoUrl          String?
  builderName       String?

  // Estimates
  estimatedValue Int?
  estimateLow    Int?
  estimateHigh   Int?
  rentEstimate   Int?

  // Scores & environmental risk (demo values)
  walkScore    Int?
  transitScore Int?
  bikeScore    Int?
  floodRisk    Int?
  fireRisk     Int?
  heatRisk     Int?
  windRisk     Int?
  airQuality   Int?
  crimeIndex   Int?
  noiseLevel   Int?

  // Rental
  availableDate     DateTime?
  leaseTermMonths   Int?
  securityDeposit   Int?
  applicationFee    Int?
  petDeposit        Int?
  petRent           Int?
  petPolicy         String?   @db.Text
  fees              Json?
  moveInSpecial     String?
  isCommunity       Boolean   @default(false)
  communityName     String?
  rentalAmenities   String[]
  laundry           String?
  furnished         Boolean   @default(false)
  utilitiesIncluded String[]

  // Commercial
  capRate              Float?
  noi                  Int?
  leaseType            String?
  leaseRate            Float?
  buildingClass        String?
  zoning               String?
  buildingSqft         Int?
  availableSqft        Int?
  occupancyPct         Float?
  parkingRatio         Float?
  ceilingHeight        Float?
  loadingDocks         Int?
  tenancy              String?
  investmentHighlights String[]
  ndaRequired          Boolean  @default(false)

  // Land
  pricePerAcre      Int?
  landTypes         String[]
  activities        String[]
  waterFeatures     String[]
  hasWaterRights    Boolean  @default(false)
  hasTimber         Boolean  @default(false)
  timberDescription String?
  soilType          String?
  topography        String?
  roadFrontageFt    Int?
  hasMineralRights  Boolean  @default(false)
  irrigation        String?
  fencing           String?
  improvements      String[]
  countyData        Json?

  // Ownership & attribution
  agentId          String?
  agent            Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerId          String?
  owner            User?         @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  brokerageName    String?
  listingAgentName String?
  attribution      String?

  // Engagement
  viewCount Int @default(0)
  saveCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media           ListingMedia[]
  priceHistory    PriceHistory[]
  taxHistory      TaxHistory[]
  openHouses      OpenHouse[]
  units           RentalUnit[]
  spaces          CommercialSpace[]
  documents       ListingDocument[]
  schools         ListingSchool[]
  favorites       Favorite[]
  collectionItems CollectionItem[]
  notes           Note[]
  views           ListingView[]
  tours           TourRequest[]
  leads           Lead[]
  applications    RentalApplication[]
  leases          Lease[]
  reports         Report[]
  ndaAgreements   NdaAgreement[]
  conversations   Conversation[]

  @@index([status, category, transactionType])
  @@index([lat, lng])
  @@index([cityId])
  @@index([neighborhoodId])
  @@index([zip])
  @@index([price])
  @@index([agentId])
  @@index([listDate])
}

model ListingMedia {
  id               String        @id @default(cuid())
  listingId        String
  listing          Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type             MediaType     @default(PHOTO)
  category         MediaCategory
  url              String
  width            Int?
  height           Int?
  alt              String
  caption          String?
  blurDataUrl      String?       @db.Text
  color            String?
  sortOrder        Int           @default(0)
  isPrimary        Boolean       @default(false)
  provider         MediaProvider
  providerId       String?
  photographer     String?
  photographerUrl  String?
  sourceUrl        String?
  license          String?
  downloadLocation String?
  createdAt        DateTime      @default(now())

  @@unique([listingId, providerId])
  @@index([listingId, sortOrder])
}

model PriceHistory {
  id        String     @id @default(cuid())
  listingId String
  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date      DateTime
  event     PriceEvent
  price     Int
  source    String?

  @@index([listingId, date])
}

model TaxHistory {
  id               String  @id @default(cuid())
  listingId        String
  listing          Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  year             Int
  taxPaid          Int
  assessedValue    Int
  landValue        Int?
  improvementValue Int?

  @@unique([listingId, year])
}

model OpenHouse {
  id        String        @id @default(cuid())
  listingId String
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  type      OpenHouseType @default(IN_PERSON)
  notes     String?

  @@index([startsAt])
}

model RentalUnit {
  id            String    @id @default(cuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  unitNumber    String
  floorPlan     String
  beds          Int
  baths         Float
  sqft          Int
  rent          Int
  deposit       Int?
  availableDate DateTime?
  isAvailable   Boolean   @default(true)
  floor         Int?
  features      String[]

  applications RentalApplication[]
  leases       Lease[]

  @@index([listingId])
}

model CommercialSpace {
  id            String    @id @default(cuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  suite         String
  spaceUse      String
  sqft          Int
  rate          Float?
  rateType      String?
  leaseType     String?
  term          String?
  availableDate DateTime?
  condition     String?
  isAvailable   Boolean   @default(true)

  @@index([listingId])
}

model ListingDocument {
  id          String  @id @default(cuid())
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name        String
  kind        String
  requiresNda Boolean @default(true)
  pages       Int?
  sizeKb      Int?
  url         String?
}

model NdaAgreement {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  email      String
  company    String?
  role       String?
  signature  String
  ipHash     String?
  acceptedAt DateTime @default(now())

  @@index([listingId, email])
}

model ListingSchool {
  listingId     String
  schoolId      String
  distanceMiles Float
  isAssigned    Boolean @default(false)
  listing       Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([listingId, schoolId])
}

// ───────────────────────────── Consumer features ─────────────────────────────

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

model Collection {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items   CollectionItem[]
  members CollectionMember[]
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listingId    String
  listing      Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  addedById    String?
  sharedNote   String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([collectionId, listingId])
}

model CollectionMember {
  id           String         @id @default(cuid())
  collectionId String
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  role         CollectionRole @default(EDITOR)
  isAgent      Boolean        @default(false)
  inviteToken  String         @unique
  acceptedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@unique([collectionId, email])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model SavedSearch {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  filters         Json
  path            String
  frequency       AlertFrequency @default(DAILY)
  emailEnabled    Boolean        @default(true)
  pushEnabled     Boolean        @default(false)
  knownListingIds String[]
  lastCheckedAt   DateTime?
  lastNotifiedAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
}

model ListingView {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, viewedAt])
}

model TourRequest {
  id            String     @id @default(cuid())
  listingId     String
  listing       Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentId       String?
  agent         Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  type          TourType
  status        TourStatus @default(REQUESTED)
  name          String
  email         String
  phone         String?
  preferredDate DateTime
  preferredTime String
  message       String?    @db.Text
  confirmedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([agentId, status])
}

model Lead {
  id            String     @id @default(cuid())
  type          LeadType
  status        LeadStatus @default(NEW)
  listingId     String?
  listing       Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  agentId       String?
  agent         Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String?
  message       String?    @db.Text
  data          Json?
  source        String?
  routingReason String?
  assignedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([agentId, status])
  @@index([createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  subject   String?
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  url       String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

model NotificationPreference {
  userId            String         @id
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailListingAlerts Boolean       @default(true)
  pushListingAlerts Boolean        @default(false)
  emailPriceDrops   Boolean        @default(true)
  emailTourUpdates  Boolean        @default(true)
  emailMessages     Boolean        @default(true)
  emailNewsletter   Boolean        @default(false)
  alertDigest       AlertFrequency @default(DAILY)
  updatedAt         DateTime       @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ───────────────────────────── Rentals ─────────────────────────────

model RentalApplication {
  id               String            @id @default(cuid())
  listingId        String
  listing          Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  unitId           String?
  unit             RentalUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           ApplicationStatus @default(DRAFT)
  moveInDate       DateTime?
  leaseTermMonths  Int?
  applicant        Json
  employment       Json?
  occupants        Int               @default(1)
  hasPets          Boolean           @default(false)
  petDetails       String?
  vehicles         Int?
  references       Json?
  consentScreening Boolean           @default(false)
  consentAt        DateTime?
  feeAmount        Int?
  feePaid          Boolean           @default(false)
  feeSessionId     String?
  submittedAt      DateTime?
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  lease Lease?

  @@index([userId])
  @@index([listingId, status])
}

model Lease {
  id              String             @id @default(cuid())
  applicationId   String?            @unique
  application     RentalApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  listingId       String
  listing         Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  unitId          String?
  unit            RentalUnit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenantId        String
  tenant          User               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  monthlyRent     Int
  securityDeposit Int?
  status          LeaseStatus        @default(PENDING_SIGNATURE)
  terms           String             @db.Text
  landlordName    String?
  signatureName   String?
  signedAt        DateTime?
  signatureIpHash String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  payments RentPayment[]

  @@index([tenantId])
}

model RentPayment {
  id              String        @id @default(cuid())
  leaseId         String
  lease           Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int
  periodStart     DateTime
  status          PaymentStatus @default(PENDING)
  method          String?
  stripeSessionId String?       @unique
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([leaseId])
}

model Purchase {
  id              String        @id @default(cuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind            String
  referenceId     String?
  amountCents     Int
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ───────────────────────────── Moderation, CMS, market ─────────────────────────────

model Report {
  id           String       @id @default(cuid())
  listingId    String
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation("ReportAuthor", fields: [userId], references: [id], onDelete: SetNull)
  reason       ReportReason
  details      String?      @db.Text
  email        String?
  status       ReportStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status])
}

model Post {
  id             String     @id @default(cuid())
  type           PostType
  status         PostStatus @default(DRAFT)
  title          String
  slug           String     @unique
  excerpt        String?
  body           String     @db.Text
  coverColor     String?
  coverImage     String?
  authorName     String?
  tags           String[]
  citySlug       String?
  readingMinutes Int?
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([type, status, publishedAt])
}

model MarketStat {
  id                 String   @id @default(cuid())
  cityId             String
  city               City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  month              DateTime
  medianListPrice    Int
  medianSoldPrice    Int
  medianRent         Int
  medianPricePerSqft Int
  inventory          Int
  newListings        Int
  medianDaysOnMarket Int
  saleToListRatio    Float

  @@unique([cityId, month])
}

model MortgageRate {
  id      String   @id @default(cuid())
  product String
  slug    String
  rate    Float
  apr     Float
  points  Float
  date    DateTime

  @@unique([slug, date])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String   @db.Text
  text      String?  @db.Text
  provider  String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  listingId String?
  agentId   String?
  userId    String?
  sessionId String?
  path      String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([listingId, type])
  @@index([agentId, type])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Upload {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique
  url       String
  mime      String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}
