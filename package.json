{
  "name": "citi-view-real-estate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:start": "node scripts/db-local.mjs",
    "db:push": "dotenv run -q -f .env.local -- prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv run -q -f .env.local -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "dotenv run -q -f .env.local -- tsx prisma/seed/index.ts",
    "db:reset": "dotenv run -q -f .env.local -- prisma db push --force-reset --skip-generate && npm run db:seed",
    "db:postgis": "dotenv run -q -f .env.local -- tsx scripts/postgis.ts",
    "db:studio": "dotenv run -q -f .env.local -- prisma studio",
    "media:fetch": "dotenv run -q -f .env.local -- tsx scripts/media-fetch.ts",
    "media:verify": "dotenv run -q -f .env.local -- tsx scripts/media-verify.ts",
    "search:sync": "dotenv run -q -f .env.local -- tsx scripts/search-sync.ts",
    "alerts:run": "dotenv run -q -f .env.local -- tsx --conditions=react-server scripts/run-alerts.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate && node scripts/copy-vendor.mjs",
    "push:keys": "node scripts/generate-vapid.mjs",
    "photos:plan": "dotenv run -q -f .env.local -- tsx scripts/ai-photos/plan.ts",
    "photos:process": "tsx scripts/ai-photos/process.ts",
    "photos:apply": "dotenv run -q -f .env.local -- tsx scripts/ai-photos/apply.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^7.0.7",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.75.0",
    "mapbox-gl": "^3.35.1",
    "maplibre-gl": "^6.19.0",
    "marked": "^18.2.1",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.1",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.92.0",
    "react-map-gl": "^8.1.3",
    "resend": "^6.39.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "typesense": "^3.2.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "description": "CITI VIEW REAL ESTATE — USA real estate marketplace (residential, rentals, new construction, commercial, land).",
  "engines": {
    "node": ">=20.11"
  }
}
